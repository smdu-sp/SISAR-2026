{
  "name": "sisar-2026",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/frontend",
    "dev:turbo": "turbo run dev",
