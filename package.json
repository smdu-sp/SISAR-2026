{
    "name":  "sisar-2026",
    "version":  "0.0.1",
    "private":  true,
    "packageManager":  "npm@11.5.2",
    "prisma":  {
                    "seed":  "ts-node --project tsconfig.node.json prisma/seed.ts"
                },
    "scripts":  {
                    "dev":  "next dev -p 3098",
                    "build":  "npm run build:api && next build",
                    "build:api":  "tsc -p tsconfig.api.json",
                    "start":  "next start -p 3098",
                    "test":  "jest",
                    "lint":  "next lint",
                    "format":  "prettier --write .",
                    "prisma:generate":  "node scripts/gerar-prisma.mjs",
                    "db:migrate:dev":  "dotenv -e .env.local -- prisma migrate dev --schema=prisma/schema.prisma",
                    "db:migrate:deploy":  "dotenv -e .env.local -- prisma migrate deploy --schema=prisma/schema.prisma",
                    "db:seed":  "dotenv -e .env.local -- prisma db seed --schema=prisma/schema.prisma",
                    "import:planilha:parse":  "python prisma/scripts/parse-planilha.py",
                    "import:planilha":  "npm run import:planilha:parse && dotenv -e .env.local -- ts-node --project tsconfig.node.json prisma/import-planilha.ts",
                    "postinstall":  "node scripts/gerar-prisma.mjs"
                },
