{
	"name": "@sisar/api",
	"version": "0.0.1",
	"private": true,
	"description": "Regras de negócio e API do SISAR (antigo backend NestJS), servidas pelo app Next.js.",
	"main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "jest",
		"prisma:generate": "dotenv -e ../../.env.local -- prisma generate && dotenv -e ../../.env.local -- prisma generate --schema=sgu/schema.prisma",
		"db:migrate:deploy": "dotenv -e ../../.env.local -- prisma migrate deploy",
		"db:migrate:dev": "dotenv -e ../../.env.local -- prisma migrate dev",
		"db:seed": "dotenv -e ../../.env.local -- prisma db seed",
		"import:planilha:parse": "python prisma/scripts/parse-planilha.py",
		"import:planilha": "npm run import:planilha:parse && dotenv -e ../../.env.local -- ts-node --project tsconfig.node.json prisma/import-planilha.ts"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.5",
		"@types/ldapjs": "^3.0.6",
		"@types/node": "^20.19.43",
		"dotenv-cli": "^11.0.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.4.15",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"prisma": {
		"seed": "ts-node --project tsconfig.node.json prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/client": "^5.22.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.4",
		"exceljs": "^4.4.0",
		"jsonwebtoken": "^9.0.3",
		"ldapjs": "^3.0.7",
		"pdfmake": "^0.3.12",
		"reflect-metadata": "^0.1.14",
		"resend": "^6.34.1"
	}
}
